{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Star party handout event",
  "type": "object",
  "properties": {
    "event_title": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "handout_mode": {"enum": ["monthly", "nightly"]},
    "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "timezone": {"type": "string", "minLength": 1},
    "location": {
      "type": "object",
      "required": ["name", "latitude", "longitude"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "elevation_m": {"type": "number", "minimum": -500, "maximum": 100000}
      },
      "additionalProperties": false
    },
    "target_candidates": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "pattern": "^(M[0-9]+(/M[0-9]+)?|NGC[0-9]+(/[0-9]+)?)$"},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
